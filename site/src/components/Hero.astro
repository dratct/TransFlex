---
// Starlight's Hero with two changes: the image keeps its own aspect ratio (the
// default renders a 400×400 square, which crops a wide app window), and a page
// can show a looping clip there instead (`heroClip` in its frontmatter).
import { LinkButton } from '@astrojs/starlight/components';
import { Image } from 'astro:assets';
import Clip from './Clip.astro';

const { data } = Astro.locals.starlightRoute.entry;
const clip = data.heroClip;
const notes = data.heroNotes ?? [];
const { title = data.title, tagline, image, actions = [] } = data.hero || {};
const pair = image && 'dark' in image ? image : undefined;
const imageAttrs = {
  loading: 'eager' as const,
  decoding: 'async' as const,
  widths: [640, 1040],
  sizes: '(min-width: 50rem) 34rem, 100vw',
  alt: image?.alt || '',
};
---

<div class="hero">
  <div class="sl-flex stack">
    <div class="sl-flex copy">
      <h1 id="_top" data-page-title set:html={title} />
      {tagline && <div class="tagline" set:html={tagline} />}
    </div>
    {
      actions.length > 0 && (
        <div class="sl-flex actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
              {icon?.html && <Fragment set:html={icon.html} />}
            </LinkButton>
          ))}
        </div>
      )
    }
    {notes.length > 0 && <ul class="notes">{notes.map((note) => <li>{note}</li>)}</ul>}
  </div>
  {clip && <Clip name={clip.name} alt={clip.alt} sizes="(min-width: 72rem) 67.5rem, 100vw" />}
  {
    !clip && pair && (
      <figure class="shot">
        <Image src={pair.dark} class="light:sl-hidden" {...imageAttrs} />
        <Image src={pair.light} class="dark:sl-hidden" {...imageAttrs} />
      </figure>
    )
  }
</div>

<style>
  @layer starlight.core {
    /* The copy, then the picture across the whole column: the app is the
       largest thing on the first screen. */
    .hero {
      display: grid;
      grid-template-columns: 100%;
      gap: clamp(2rem, 6vw, 4rem);
      padding-block: clamp(1.5rem, 6vw, 5rem) 1rem;
    }

    .stack {
      flex-direction: column;
      gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
    }

    .copy {
      flex-direction: column;
      gap: 1.25rem;
    }

    h1 {
      max-width: 14ch;
      font-size: clamp(2.5rem, calc(1rem + 6.5vw), 5.25rem);
      line-height: 1.02;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: var(--sl-color-white);
    }

    .tagline {
      max-width: 46ch;
      font-size: clamp(var(--sl-text-base), calc(0.5rem + 1.2vw), var(--sl-text-xl));
      line-height: 1.5;
      color: var(--sl-color-gray-2);
    }

    .actions {
      gap: 1rem 1.5rem;
      flex-wrap: wrap;
      align-items: center;
    }

    .notes {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 0;
      margin: 0;
      padding: 0;
      list-style: none;
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-sm);
    }

    /* The dot trails its item, so a wrapped line never starts with one. */
    .notes li:not(:last-child)::after {
      content: '·';
      margin-inline: 0.75rem;
    }
  }
</style>
