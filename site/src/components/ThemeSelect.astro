---
// The header's links to Docs, Blog and the support page, before Starlight's theme
// picker. Wide screens only; on a phone the same links are in the footer.
import Default from '@astrojs/starlight/components/ThemeSelect.astro';
import { Icon } from '@astrojs/starlight/components';
import { localized, supportHref } from './links';

const { locale } = Astro.locals.starlightRoute;
const t = Astro.locals.t;
---

<nav class="tf-nav" aria-label="TransFlex">
  <a href={localized('/docs/install/', locale)}>{t('tf.nav.docs')}</a>
  <a href={localized('/blog/', locale)}>{t('tf.nav.blog')}</a>
  <a class="tf-nav-support" href={supportHref}><Icon name="heart" />{t('tf.nav.support')}</a>
</nav>
<Default><slot /></Default>

<style>
  .tf-nav {
    display: none;
    gap: 1rem;
    align-items: center;
    padding-inline-end: 1rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }

  @media (min-width: 50rem) {
    .tf-nav {
      display: flex;
    }
  }

  .tf-nav a {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .tf-nav a:hover {
    color: var(--sl-color-text-accent);
  }

  .tf-nav-support :global(svg) {
    color: var(--sl-color-text-accent);
  }
</style>
