---
import { LinkButton } from '@astrojs/starlight/components';
import { supportHref } from './links';

interface Props {
  label: string;
  allReleases: string;
  support: string;
  note: string;
}

const { label, allReleases, support, note } = Astro.props;
// The release workflow attaches the archive under this fixed name (scripts/publish-release.sh).
const href = 'https://github.com/dratct/TransFlex/releases/latest/download/TransFlex-macos.zip';
---

<div class="download not-content">
  <LinkButton href={href} icon="download" iconPlacement="start">{label}</LinkButton>
  <LinkButton href={supportHref} class="tf-support" icon="heart" iconPlacement="start">{support}</LinkButton>
  <a class="download-all" href="https://github.com/dratct/TransFlex/releases">{allReleases}</a>
  <p class="download-note">{note}</p>
  <div class="download-keys" aria-hidden="true"><kbd>⌥</kbd><kbd>T</kbd></div>
</div>
