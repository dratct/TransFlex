---
// Starlight's Header, plus two things for phones: the support button, which wide
// screens get from ThemeSelect.astro, and the language picker on pages without a
// sidebar. Starlight puts that picker in the sidebar menu, so a splash page has none.
import Default from '@astrojs/starlight/components/Header.astro';
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import { Icon } from '@astrojs/starlight/components';
import { supportHref } from './links';

const { hasSidebar } = Astro.locals.starlightRoute;
const t = Astro.locals.t;
---

<div class="tf-header">
  <Default />
  <a class="tf-support tf-header-support print:hidden" href={supportHref}>
    <Icon name="heart" />{t('tf.nav.support')}
  </a>
  {
    !hasSidebar && (
      <div class="tf-header-language md:sl-hidden print:hidden">
        <LanguageSelect />
      </div>
    )
  }
</div>

<style>
  .tf-header {
    display: flex;
    gap: var(--sl-nav-gap);
    align-items: center;
    height: 100%;
  }

  .tf-header > :global(.header) {
    flex: 1;
    min-width: 0;
  }

  /* Beside the support button a phone has no room for the language's name:
     the picker shows its icon and arrow, and the list still names each one. */
  .tf-header-language :global(label) {
    --sl-select-width: 0.5em !important;
  }

  .tf-header-support {
    display: none;
    gap: 0.35rem;
    align-items: center;
    white-space: nowrap;
  }

  @media (max-width: 49.99rem) {
    .tf-header-support {
      display: inline-flex;
    }
  }
</style>
