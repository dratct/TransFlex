---
// Starlight's Header, plus the language picker on phones for pages without a sidebar.
// Starlight puts that picker in the sidebar menu, so a splash page on a phone has none.
import Default from '@astrojs/starlight/components/Header.astro';
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="tf-header">
  <Default />
  {
    !hasSidebar && (
      <div class="md:sl-hidden print:hidden">
        <LanguageSelect />
      </div>
    )
  }
</div>

<style>
  .tf-header {
    display: flex;
    gap: var(--sl-nav-gap);
    align-items: center;
    height: 100%;
  }

  .tf-header > :global(.header) {
    flex: 1;
    min-width: 0;
  }
</style>
