// Code signing for the TransFlex app target only, so Swift package targets keep their own settings.
// Defaults build ad-hoc with the file-based keychain; a git-ignored Local.xcconfig switches a
// machine to team signing, and scripts/build.sh writes DeveloperID.generated.xcconfig for releases.

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
CODE_SIGNING_REQUIRED = NO
CODE_SIGNING_ALLOWED = YES
DEVELOPMENT_TEAM =
ENABLE_HARDENED_RUNTIME = NO
CODE_SIGN_ENTITLEMENTS = TransFlex/TransFlex.entitlements

// `file` or `dataProtection`; written into Info.plist as TransFlexKeychainBackend.
TRANSFLEX_KEYCHAIN_BACKEND = file

// A keychain file of the Debug build's own, set only by a machine's Local.xcconfig; written into
// Info.plist as TransFlexKeychainPath and, when set, used instead of TRANSFLEX_KEYCHAIN_BACKEND.
TRANSFLEX_KEYCHAIN_PATH =

#include? "Local.xcconfig"
#include? "DeveloperID.generated.xcconfig"

// Release never uses a Debug keychain, whatever Local.xcconfig sets.
TRANSFLEX_KEYCHAIN_PATH[config=Release] =
